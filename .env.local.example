# Copy this file to .env.local for local-only overrides.
# Do not put API keys in this file.

# Optional. Leave empty to keep the existing browser storage:
# localStorage key: gpt-image-playground
# IndexedDB name: gpt-image-playground
VITE_STORAGE_NAMESPACE=

# Optional. Used only as the default API URL for new profiles.
VITE_DEFAULT_API_URL=

# Optional. The dev proxy is normally detected from dev-proxy.config.json.
VITE_API_PROXY_AVAILABLE=false
VITE_API_PROXY_LOCKED=false
